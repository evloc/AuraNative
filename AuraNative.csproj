<Project Sdk="Microsoft.NET.Sdk">
  <!-- AURA Native: a plain Windows app (.NET Framework 4.8, built into Windows 10 and 11).
       No Python, no web engine, nothing to install. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>10.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>AURA Native</AssemblyName>
    <RootNamespace>Aura</RootNamespace>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <Version>0.4.5</Version>
    <Product>AURA Native</Product>
    <Company>AURA</Company>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>CS0649</NoWarn>
    <DebugType>none</DebugType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <!-- Building on Linux/macOS (for testing): use Mono's copies of the Windows reference files -->
  <PropertyGroup Condition="'$(OS)' != 'Windows_NT'">
    <FrameworkPathOverride>/usr/lib/mono/4.8-api</FrameworkPathOverride>
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
    <DefineConstants>$(DefineConstants);TESTHOOKS</DefineConstants>
  </PropertyGroup>
  <!-- test helpers are only built for testing, never into the Windows app -->
  <ItemGroup Condition="'$(OS)' == 'Windows_NT'">
    <Compile Remove="test/**" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="native/**;build/**" />
  </ItemGroup>
  <!-- The smooth lyrics and full screen are drawn by the graphics card with WPF (part of Windows' .NET) -->
  <PropertyGroup Condition="'$(OS)' == 'Windows_NT'">
    <DefineConstants>$(DefineConstants);WPF</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(OS)' == 'Windows_NT'">
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
    <Reference Include="WindowsFormsIntegration" />
  </ItemGroup>
  <!-- On Linux (testing only) the WPF parts are compile-checked against stand-ins, when they're there -->
  <PropertyGroup Condition="'$(OS)' != 'Windows_NT' And Exists('$(WpfStubs)')">
    <DefineConstants>$(DefineConstants);WPF</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(OS)' != 'Windows_NT' And Exists('$(WpfStubs)')">
    <Reference Include="WpfStubs"><HintPath>$(WpfStubs)</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.Xml" />
    <Reference Include="System.Xml.Linq" />
  </ItemGroup>
</Project>
